# Copy this file to .env and fill in your own values.
# The server reads these as normal environment variables
# (via your host's settings, or a tool like `dotenv` if you add it).

# Password required to use the admin panel (admin.html) and admin API routes.
# Pick something long and random — this is the only thing protecting your
# submissions, comments, and portfolio editor.
ADMIN_KEY=change-me-to-something-long-and-random

# Port the server listens on. Most hosts set this for you automatically.
PORT=3000
